# Скопируйте в .env и подставьте значения, либо экспортируйте в shell перед `gradlew run`.
# Ktor читает переменные окружения напрямую (см. AppConfig.kt).

JDBC_URL=jdbc:postgresql://localhost:15432/apofeoz
DB_USER=apofeoz
DB_PASSWORD=apofeoz

JWT_SECRET=change-me-min-32-characters-long-secret
JWT_ISSUER=apofeoz
JWT_AUDIENCE=apofeoz-mobile

# Календарные сутки отчётов и разбивка по полуночи — по умолчанию Москва
REPORT_TIME_ZONE=Europe/Moscow

# CORS (опционально): список origin через запятую, например
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://admin-test.example.com
# Если пусто — anyHost (dev-режим поведения).
# CORS_ALLOWED_ORIGINS=

# Опционально: создать первого администратора при первом старте
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=SecurePass123
# SEED_ADMIN_PHONE=
