# --- Postgres container ---
POSTGRES_DB=apofeoz
POSTGRES_USER=apofeoz
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend app ---
JDBC_URL=jdbc:postgresql://postgres:5432/apofeoz
DB_USER=apofeoz
DB_PASSWORD=change-me-strong-password

JWT_SECRET=replace-with-very-strong-32-plus-secret
JWT_ISSUER=apofeoz
JWT_AUDIENCE=apofeoz-mobile
REPORT_TIME_ZONE=Europe/Moscow
CORS_ALLOWED_ORIGINS=https://admin.example.com

# Optional one-time admin seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-password
SEED_ADMIN_PHONE=

# --- Admin web app ---
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
